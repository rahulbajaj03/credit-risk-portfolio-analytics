# Copy to .env (local) or set these in your Streamlit Cloud / HF Spaces secrets.
# Names only - never commit real values.

# Enables the "Ask the Portfolio" LLM feature. If unset, the app runs in a
# deterministic fallback mode that still answers from the real figures.
OPENAI_API_KEY=

# Optional: point at any OpenAI-compatible endpoint (Azure, local, etc.).
# Leave blank to use the default OpenAI API.
OPENAI_BASE_URL=

# Optional: override the chat model used (default: gpt-4o-mini).
LLM_MODEL=gpt-4o-mini
