# Example for Streamlit Community Cloud "Secrets" (Settings -> Secrets).
# Paste the real key there in the dashboard - do NOT commit the real file.
# The app reads these via os.getenv, and Streamlit exposes secrets as env vars.

OPENAI_API_KEY = "sk-..."
